#!/usr/bin/env bash
set -Eeuo pipefail
CAMT_HOME="/opt/camt"
CAMT_VENV="$CAMT_HOME/.venv"
CAMT_PYTHON="$CAMT_VENV/bin/python"

die(){ echo "ERROR: $*" >&2; exit 1; }

[ -x "$CAMT_PYTHON" ] || die "CAMT runtime is missing. Rerun the CAMT installer."
"$CAMT_PYTHON" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3,12) else 1)' \
  || die "CAMT runtime Python is invalid. Rerun the CAMT installer."

export CAMT_HOME
export PYTHONPATH="$CAMT_HOME/src${PYTHONPATH:+:$PYTHONPATH}"
cd "$CAMT_HOME"

if [ "${1:-}" = "--camt-launcher-check" ]; then
  exec "$CAMT_PYTHON" - <<'PY'
import projectmanager, tkinter, _tkinter
from scapy.all import IP, TCP
from cryptography.hazmat.primitives import hashes
print("CAMT launcher/runtime: OK")
PY
fi

exec "$CAMT_PYTHON" -m projectmanager "$@"
